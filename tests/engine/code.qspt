// Ported from qsp-wasm-engine tests/engine/code.test.ts

@test long line split
@src

t = 1
tort = 0
if t _
   or _
   t:
  $type = 'new'
else
  $type = 'old'
end

@run
@expect $type => 'new'

@test long line split with tab before marker
@src

t = 1
if t	_
   or	_
   t:
  $type = 'new'
else
  $type = 'old'
end

@run
@expect $type => 'new'

@test empty statements between separators are allowed
@src
a = 1 && b = 2 & & c = 3
@run
@expect a => 1
@expect b => 2
@expect c => 3

@test statement argument gets converted to string
@src
 msg 567
@run
@expect-event msg 567

@test statement argument gets converted to number
@src
 wait '567'
@run
@expect-event wait 567

@test statement argument cant be converted to number
@src
 wait 'sdsd'
@run
@expect-error TYPEMISMATCH (location 'test', line 1, local 0, action -1) WAIT 'sdsd'

@test function argument gets converted to string
@src
 $x = replace(123456, 456, 34)
@run
@expect $x => '12334'

// wasm: x => -14620148; the number depends on the build (QSP_USE_BIGINT), see graphics.qspt
@test function argument gets converted to number
@src
 x = rgb('12', '234', 32)
@run
@expect x = rgb(12, 234, 32) => 1

@test function argument cant be converted to number
@src
 x = rgb('123', '65sd', 56)
@run
@expect-error TYPEMISMATCH (location 'test', line 1, local 0, action -1) X = RGB('123', '65sd', 56)
